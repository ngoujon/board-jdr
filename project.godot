; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Arcanes & Lames"
config/description="Jeu de cartes médiéval-fantastique en pixel art 8-bit."
config/version="2.0.3"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/game_icon.png"
config/windows_native_icon="res://assets/ui/game_icon.ico"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.101961, 0.0705882, 0.12549, 1)
boot_splash/image="res://assets/bg/menu.png"
boot_splash/stretch_mode=4
boot_splash/use_filter=false

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Updater="*res://scripts/autoload/updater.gd"
Audio="*res://scripts/autoload/audio.gd"
CardDB="*res://scripts/autoload/card_db.gd"
UITheme="*res://scripts/autoload/ui_theme.gd"
Lobby="*res://scripts/autoload/lobby.gd"
Net="*res://scripts/autoload/net.gd"
PauseMenu="*res://scripts/autoload/pause_menu.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[gui]

theme/default_font_antialiasing=0

[internationalization]

locale/fallback="fr"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method.android="gl_compatibility"

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
